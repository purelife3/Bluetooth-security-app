name: Test Build Setup

on:
  workflow_dispatch:  # Manual trigger only

env:
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: true

jobs:
  test-setup:
    runs-on: ubuntu-latest
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4.3.0  # Latest version built for Node.js 24
      
    - name: Set up Python
      uses: actions/setup-python@v5.3.0  # Latest version built for Node.js 24
      with:
        python-version: '3.12'
        
    - name: Verify files exist
      run: |
        echo "Checking essential files..."
        ls -la
        echo ""
        echo "Checking buildozer.spec..."
        if [ -f "buildozer.spec" ]; then
          echo "✓ buildozer.spec exists"
          head -20 buildozer.spec
        else
          echo "✗ buildozer.spec missing"
          exit 1
        fi
        
        echo ""
        echo "Checking main.py..."
        if [ -f "main.py" ]; then
          echo "✓ main.py exists"
          wc -l main.py
        else
          echo "✗ main.py missing"
          exit 1
        fi
        
        echo ""
        echo "Checking bluetooth.kv..."
        if [ -f "bluetooth.kv" ]; then
          echo "✓ bluetooth.kv exists"
          wc -l bluetooth.kv
        else
          echo "✗ bluetooth.kv missing"
          exit 1
        fi
        
    - name: Install Buildozer (test only)
      run: |
        python3 -m pip install --upgrade pip wheel setuptools
        python3 -m pip install buildozer cython==0.29.36
        echo "Buildozer version:"
        buildozer --version
        
    - name: Test Buildozer initialization
      run: |
        echo "Testing Buildozer initialization..."
        buildozer init  # This will create a default spec if missing, but we have one
        
    - name: Upload verification results
      uses: actions/upload-artifact@v4.4.0
      with:
        name: verification-results
        path: |
          buildozer.spec
          main.py
          bluetooth.kv
        retention-days: 1