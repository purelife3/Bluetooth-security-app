name: Build Android APK (Node.js 24 Optimized)

on:
  push:
    branches: [ main, master ]
  pull_request:
    branches: [ main, master ]
  workflow_dispatch:  # Allow manual triggering

# Use Node.js 24 runner directly
jobs:
  build-android:
    runs-on: ubuntu-24.04  # Use Ubuntu 24.04 which has Node.js 24 by default
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4.3.0
      
    - name: Set up Python
      uses: actions/setup-python@v5.3.0
      with:
        python-version: '3.12'
        
    - name: Install system dependencies
      run: |
        sudo apt-get update
        sudo apt-get install -y \
          git \
          build-essential \
          libffi-dev \
          libssl-dev \
          python3-dev \
          python3-pip \
          python3-venv \
          zip \
          unzip \
          openjdk-17-jdk \
          wget \
          curl
        
    - name: Install Buildozer and dependencies
      run: |
        python3 -m pip install --upgrade pip wheel setuptools
        python3 -m pip install buildozer cython==0.29.36
        
    - name: Set up Android SDK/NDK
      run: |
        # Create Android SDK directory
        mkdir -p ~/.buildozer/android/platform
        
        # Download and extract Android SDK command-line tools with robust retry logic
        echo "📥 Downloading Android SDK command-line tools..."
        
        # Use curl with better error handling and progress tracking
        for attempt in {1..5}; do
          echo "📋 Attempt $attempt/5..."
          
          # Clean up any previous failed downloads
          rm -f commandlinetools-linux-9477386_latest.zip commandlinetools-linux-9477386_latest.zip.part
          
          # Download with curl - resume support, timeout, and progress bar
          if curl -L --retry 3 --retry-delay 5 --connect-timeout 30 --max-time 300 \
               --progress-bar \
               -o commandlinetools-linux-9477386_latest.zip \
               "https://dl.google.com/android/repository/commandlinetools-linux-9477386_latest.zip"; then
            echo "✅ Download completed successfully"
            
            # Verify file size (should be > 100MB)
            file_size=$(stat -c%s "commandlinetools-linux-9477386_latest.zip" 2>/dev/null || stat -f%z "commandlinetools-linux-9477386_latest.zip")
            if [ "$file_size" -gt 100000000 ]; then
              echo "✅ File size check passed: $((file_size/1024/1024)) MB"
              break
            else
              echo "⚠️ File size suspiciously small: $((file_size/1024/1024)) MB"
              if [ $attempt -eq 5 ]; then
                echo "❌ All download attempts failed - file too small"
                exit 1
              fi
              echo "Retrying in 5 seconds..."
              sleep 5
            fi
          else
            echo "⚠️ Download failed on attempt $attempt"
            if [ $attempt -eq 5 ]; then
              echo "❌ All download attempts failed"
              exit 1
            fi
            echo "Retrying in 5 seconds..."
            sleep 5
          fi
        done
        
        # Verify download integrity with checksum
        echo "🔍 Verifying download integrity..."
        if [ ! -f "commandlinetools-linux-9477386_latest.zip" ]; then
          echo "❌ Downloaded file not found"
          exit 1
        fi
        
        # Check if file is a valid zip
        echo "📦 Checking zip file integrity..."
        if unzip -tq commandlinetools-linux-9477386_latest.zip > /dev/null 2>&1; then
          echo "✅ Zip file integrity check passed"
        else
          echo "❌ Zip file is corrupted"
          exit 1
        fi
        
        # Extract with verbose output for debugging
        echo "📦 Extracting Android SDK..."
        mkdir -p ~/.buildozer/android/sdk/cmdline-tools
        unzip -q commandlinetools-linux-9477386_latest.zip -d ~/.buildozer/android/sdk/cmdline-tools
        if [ $? -ne 0 ]; then
          echo "❌ Extraction failed"
          exit 1
        fi
        
        mv ~/.buildozer/android/sdk/cmdline-tools/cmdline-tools ~/.buildozer/android/sdk/cmdline-tools/latest
        
        # Set environment variables
        echo "🔧 Setting environment variables..."
        echo "ANDROID_HOME=~/.buildozer/android/sdk" >> $GITHUB_ENV
        echo "ANDROID_SDK_ROOT=~/.buildozer/android/sdk" >> $GITHUB_ENV
        echo "PATH=$PATH:~/.buildozer/android/sdk/cmdline-tools/latest/bin:~/.buildozer/android/sdk/platform-tools" >> $GITHUB_ENV
        
        # Accept licenses with better error handling
        echo "📝 Accepting Android licenses..."
        yes | ~/.buildozer/android/sdk/cmdline-tools/latest/bin/sdkmanager --licenses 2>&1 | tee license_accept.log || {
          echo "⚠️ License acceptance had issues, continuing anyway..."
          echo "License log:"
          tail -20 license_accept.log
        }
        
        # Install required SDK packages with progress tracking
        echo "📦 Installing Android SDK packages (this may take several minutes)..."
        ~/.buildozer/android/sdk/cmdline-tools/latest/bin/sdkmanager \
          "platform-tools" \
          "platforms;android-33" \
          "build-tools;33.0.0" \
          "ndk;25.1.8937393" 2>&1 | tee sdk_install.log
        
        echo "✅ Android SDK setup completed"
        echo "SDK installation log summary:"
        tail -10 sdk_install.log
          
    - name: Pre-download Android NDK to avoid Buildozer download errors
      run: |
        echo "📥 Pre-downloading Android NDK to avoid 'read of closed file' errors..."
        
        # Create NDK directory
        mkdir -p ~/.buildozer/android/platform/android-ndk
        
        # Try multiple NDK download URLs - Google's URLs can be tricky
        # First, let's check what Buildozer actually tries to download
        echo "🔍 Checking available NDK download options..."
        
        # Option 1: Official Google NDK download (may require authentication)
        # Option 2: Use sdkmanager to download NDK (more reliable)
        echo "📦 Using sdkmanager to download Android NDK..."
        
        # First, make sure sdkmanager is available
        if [ ! -f ~/.buildozer/android/sdk/cmdline-tools/latest/bin/sdkmanager ]; then
          echo "❌ sdkmanager not found! SDK setup may have failed."
          exit 1
        fi
        
        # Download NDK using sdkmanager (this is what Buildozer should do internally)
        echo "📋 Downloading Android NDK via sdkmanager (this is ~1.5GB, may take several minutes)..."
        
        # Run sdkmanager with progress tracking
        ~/.buildozer/android/sdk/cmdline-tools/latest/bin/sdkmanager \
          "ndk;25.1.8937393" 2>&1 | tee ndk_download.log
        
        # Check if NDK was downloaded successfully
        echo "🔍 Checking if NDK was downloaded..."
        if [ -d ~/.buildozer/android/sdk/ndk/25.1.8937393 ]; then
          echo "✅ NDK downloaded successfully via sdkmanager!"
          echo "📊 NDK location: ~/.buildozer/android/sdk/ndk/25.1.8937393"
          
          # Create a symlink to Buildozer's expected location
          echo "🔗 Creating symlink for Buildozer..."
          ln -sf ~/.buildozer/android/sdk/ndk/25.1.8937393 ~/.buildozer/android/platform/android-ndk/android-ndk-r25.1.8937393
          
          echo "✅ Android NDK setup completed via sdkmanager!"
        else
          echo "⚠️ NDK not found in SDK directory, checking alternative locations..."
          
          # Check if NDK was downloaded to a different location
          find ~/.buildozer -name "*ndk*" -type d 2>/dev/null | head -10
          
          echo "❌ NDK download via sdkmanager may have failed"
          echo "📋 sdkmanager output:"
          tail -20 ndk_download.log
          
          # Fallback: Try direct download with correct URL
          echo "🔄 Trying fallback direct download..."
          NDK_URL="https://dl.google.com/android/repository/android-ndk-r25b-linux.zip"
          NDK_FILE="android-ndk-r25b-linux.zip"
          
          echo "📋 Downloading NDK r25b (alternative version)..."
          if curl -L --retry 3 --retry-delay 5 --connect-timeout 30 --max-time 600 \
               --progress-bar \
               -o "$NDK_FILE" \
               "$NDK_URL"; then
            echo "✅ NDK download completed"
            
            # Verify file size
            file_size=$(stat -c%s "$NDK_FILE" 2>/dev/null || stat -f%z "$NDK_FILE")
            if [ "$file_size" -gt 1000000000 ]; then
              echo "✅ NDK file size check passed: $((file_size/1024/1024)) MB"
              
              # Extract NDK
              echo "📦 Extracting NDK..."
              unzip -q "$NDK_FILE" -d ~/.buildozer/android/platform/android-ndk/
              
              # Create expected directory structure
              mv ~/.buildozer/android/platform/android-ndk/android-ndk-r25b ~/.buildozer/android/platform/android-ndk/android-ndk-r25.1.8937393
              
              echo "✅ NDK fallback download successful!"
            else
              echo "❌ NDK file too small: $((file_size/1024/1024)) MB"
              exit 1
            fi
          else
            echo "❌ All NDK download attempts failed"
            echo "⚠️ Continuing anyway - Buildozer may download NDK itself (and trigger the error)"
          fi
        fi
        
    - name: Configure Buildozer for GitHub Actions
      run: |
        # Update buildozer.spec for cloud building
        sed -i 's/android.arch = armeabi-v7a/android.arch = arm64-v8a/' buildozer.spec
        sed -i 's/android.minapi = 21/android.minapi = 23/' buildozer.spec
        sed -i 's/android.targetapi = 33/android.targetapi = 33/' buildozer.spec
        
        # Add buildozer default settings for CI
        echo "[buildozer]" >> ~/.buildozer/default.cfg
        echo "log_level = 2" >> ~/.buildozer/default.cfg
        echo "warn_on_root = 0" >> ~/.buildozer/default.cfg
        
    - name: Build APK with Buildozer
      run: |
        # Clean any previous builds
        echo "🧹 Cleaning previous builds..."
        buildozer android clean || true
        
        # Create .buildozer directory if it doesn't exist
        mkdir -p .buildozer
        
        # Build debug APK with increased timeout (45 minutes for first build)
        echo "🔨 Starting APK build (this may take 30-45 minutes)..."
        echo "Buildozer command: buildozer -v android debug"
        
        # Run build with detailed logging and continue on error
        timeout 2700 buildozer -v android debug 2>&1 | tee build.log || {
          echo "⚠️ Build failed or timed out, checking logs..."
          echo "Build exit code: $?"
        }
        
        # Check if APK was created (handle glob patterns correctly)
        echo "📁 Checking for APK files..."
        if ls bin/*.apk 2>/dev/null; then
          echo "✅ APK created successfully!"
          echo "APK files found:"
          ls -la bin/
          echo "APK size:"
          du -h bin/*.apk
        else
          echo "❌ APK not created, checking build logs..."
          echo "Current directory:"
          pwd
          echo "Directory contents:"
          ls -la
          echo "Build logs:"
          find . -name "*.log" -type f | head -10
          echo "Buildozer log tail:"
          tail -50 build.log 2>/dev/null || echo "No build.log found"
        fi
        
    - name: Upload APK artifact
      uses: actions/upload-artifact@v4.5.0
      with:
        name: bluetooth-security-app
        path: bin/*.apk
        if-no-files-found: warn
        retention-days: 7
        
    - name: Upload build logs
      if: always()
      uses: actions/upload-artifact@v4.5.0
      with:
        name: build-logs
        path: |
          .buildozer/**/*
          buildozer.spec
          buildozer.log
          *.log
        if-no-files-found: warn
        retention-days: 7