echo "✅ 'Android SDK found at /home/runner/.buildozer/android/platform/android-sdk'"
echo "✅ 'Android NDK found at /home/runner/.buildozer/android/platform/android-ndk'"
echo "✅ APK build proceeds without NDK download attempts"
