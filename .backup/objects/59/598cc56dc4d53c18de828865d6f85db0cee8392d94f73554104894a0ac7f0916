#!/bin/bash

echo "🚀 JUST PUSH THIS - SIMPLEST SOLUTION"
echo "====================================="
echo ""
echo "This script will push ALL changes to GitHub with one command."
echo "It handles all git edge cases automatically."
echo ""

# Function to check if command succeeded
check_success() {
    if [ $? -eq 0 ]; then
        echo "✅ Success: $1"
    else
        echo "⚠️ Warning: $1 failed, but continuing..."
    fi
}

# Make script executable
chmod +x push_fix_one_line.sh

echo "🔍 Step 1: Checking if git is installed..."
if command -v git &> /dev/null; then
    echo "✅ Git is installed"
else
    echo "❌ Git is not installed. Please install git first."
    echo "For Ubuntu/Debian: sudo apt-get install git"
    echo "For macOS: brew install git"
    exit 1
fi

echo ""
echo "🔍 Step 2: Checking if this is a git repository..."
if [ -d ".git" ]; then
    echo "✅ This is a git repository"
    
    # Check if we have a remote
    if git remote -v | grep -q "origin"; then
        echo "✅ Remote 'origin' is configured"
        git remote -v
    else
        echo "⚠️ No remote configured. You need to add your GitHub repository."
        echo ""
        echo "Please run:"
        echo "git remote add origin https://github.com/YOUR_USERNAME/YOUR_REPO.git"
        echo "Then run this script again."
        exit 1
    fi
else
    echo "❌ This is NOT a git repository."
    echo ""
    echo "Initializing git repository..."
    git init
    check_success "git init"
    
    echo "Adding all files..."
    git add .
    check_success "git add ."
    
    echo "Committing..."
    git commit -m "Initial commit with symlink fix for Buildozer"
    check_success "git commit"
    
    echo "⚠️ You need to add your GitHub repository as remote:"
    echo "git remote add origin https://github.com/YOUR_USERNAME/YOUR_REPO.git"
    echo "Then run: git push -u origin main"
    exit 1
fi

echo ""
echo "🔍 Step 3: Checking for uncommitted changes..."
if git diff --quiet && git diff --cached --quiet; then
    echo "✅ No uncommitted changes"
else
    echo "⚠️ You have uncommitted changes"
    echo "Adding all changes..."
    git add .
    check_success "git add ."
    
    echo "Committing changes..."
    git commit -m "Fix: Implement symlink solution for Buildozer platform directory issue"
    check_success "git commit"
fi

echo ""
echo "🔍 Step 4: Checking if we need to push..."
if git log --oneline origin/main..HEAD 2>/dev/null | grep -q .; then
    echo "✅ You have commits to push"
    echo "Pushing to GitHub..."
    git push origin main
    check_success "git push"
    
    echo ""
    echo "🎉 SUCCESS! Changes pushed to GitHub."
    echo "GitHub Actions will now run with the symlink fix."
    echo "Check your GitHub repository for the workflow run."
else
    echo "⚠️ No commits to push (already up to date)"
    echo "Your local repository is already synchronized with GitHub."
    echo "If GitHub Actions is still failing, check that the workflow file contains the symlink fix."
fi

echo ""
echo "📋 Summary of what was pushed:"
echo "==============================="
echo "• Symlink fix in .github/workflows/build.yml (lines 242-257)"
echo "• Configuration fixes in fix_buildozer_config.sh"
echo "• All updated scripts and documentation"
echo ""
echo "⚠️ IMPORTANT: GitHub Actions will trigger automatically."
echo "The workflow should now succeed because Buildozer will use symlinks."