#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""
Android Bluetooth App
A Bluetooth management application for Android built with Kivy
"""

import kivy
kivy.require('2.3.0')

from kivy.app import App
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.button import Button
from kivy.uix.label import Label
from kivy.uix.scrollview import ScrollView
from kivy.uix.gridlayout import GridLayout
from kivy.clock import Clock
from kivy.properties import StringProperty, ListProperty, BooleanProperty, NumericProperty
from kivy.lang import Builder

# Try to import Bluetooth modules
try:
    from plyer import bluetooth
    BLUETOOTH_AVAILABLE = True
except ImportError:
    BLUETOOTH_AVAILABLE = False
    print("Warning: plyer.bluetooth not available. Using mock data.")

# Load Kivy language file
Builder.load_file('bluetooth.kv')

class BluetoothDeviceItem(BoxLayout):
    """Widget for displaying a Bluetooth device"""
    device_name = StringProperty("Unknown Device")
    device_address = StringProperty("00:00:00:00:00:00")
    device_type = StringProperty("Unknown")
    
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.orientation = 'vertical'
        self.size_hint_y = None
        self.height = 80
        self.padding = [10, 10]
        
        # Device info layout
        info_layout = BoxLayout(orientation='horizontal')
        info_layout.add_widget(Label(text=self.device_name, size_hint_x=0.6))
        info_layout.add_widget(Label(text=self.device_address, size_hint_x=0.4))
        self.add_widget(info_layout)
        
        # Action buttons
        btn_layout = BoxLayout(orientation='horizontal', size_hint_y=0.4)
        btn_layout.add_widget(Button(text='Connect', on_press=self.connect_device))
        btn_layout.add_widget(Button(text='Pair', on_press=self.pair_device))
        self.add_widget(btn_layout)
    
    def connect_device(self, instance):
        print(f"Connecting to {self.device_name} ({self.device_address})")
    
    def pair_device(self, instance):
        print(f"Pairing with {self.device_name} ({self.device_address})")

class BluetoothAppLayout(BoxLayout):
    """Main application layout"""
    status_text = StringProperty("Bluetooth App Ready")
    devices = ListProperty([])
    
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.orientation = 'vertical'
        self.padding = [20, 20]
        self.spacing = 10
        
        # Status label
        self.status_label = Label(text=self.status_text, size_hint_y=0.1)
        self.add_widget(self.status_label)
        
        # Control buttons
        controls = BoxLayout(orientation='horizontal', size_hint_y=0.15, spacing=10)
        
        self.scan_btn = Button(text='Scan Devices', on_press=self.scan_devices)
        self.connect_btn = Button(text='Connect', on_press=self.connect_to_device)
        self.disconnect_btn = Button(text='Disconnect', on_press=self.disconnect_device)
        self.toggle_btn = Button(text='Toggle Bluetooth', on_press=self.toggle_bluetooth)
        
        controls.add_widget(self.scan_btn)
        controls.add_widget(self.connect_btn)
        controls.add_widget(self.disconnect_btn)
        controls.add_widget(self.toggle_btn)
        
        self.add_widget(controls)
        
        # Devices list
        self.devices_scroll = ScrollView(size_hint_y=0.7)
        self.devices_layout = GridLayout(cols=1, spacing=10, size_hint_y=None)
        self.devices_layout.bind(minimum_height=self.devices_layout.setter('height'))
        self.devices_scroll.add_widget(self.devices_layout)
        self.add_widget(self.devices_scroll)
        
        # Log area
        self.log_label = Label(text="Log:\n", size_hint_y=0.15, halign='left', valign='top')
        self.log_label.bind(size=self.log_label.setter('text_size'))
        self.add_widget(self.log_label)
        
        # Initialize with mock data if Bluetooth not available
        if not BLUETOOTH_AVAILABLE:
            self.log("Warning: Using mock Bluetooth data")
            self.add_mock_devices()
    
    def log(self, message):
        """Add message to log"""
        self.log_label.text += f"{message}\n"
    
    def add_mock_devices(self):
        """Add mock Bluetooth devices for testing"""
        mock_devices = [
            {"name": "Wireless Headphones", "address": "AA:BB:CC:11:22:33", "type": "Audio"},
            {"name": "Smart Watch", "address": "DD:EE:FF:44:55:66", "type": "Wearable"},
            {"name": "Car Audio", "address": "11:22:33:AA:BB:CC", "type": "Audio"},
            {"name": "Keyboard", "address": "44:55:66:DD:EE:FF", "type": "HID"},
            {"name": "Fitness Tracker", "address": "77:88:99:00:11:22", "type": "Wearable"},
        ]
        
        for device in mock_devices:
            item = BluetoothDeviceItem(
                device_name=device["name"],
                device_address=device["address"],
                device_type=device["type"]
            )
            self.devices_layout.add_widget(item)
            self.devices.append(device)
    
    def scan_devices(self, instance):
        """Scan for nearby Bluetooth devices"""
        self.log("Scanning for Bluetooth devices...")
        self.status_label.text = "Scanning..."
        
        if BLUETOOTH_AVAILABLE:
            try:
                # Clear existing devices
                self.devices_layout.clear_widgets()
                self.devices = []
                
                # Start scanning (this would use actual Bluetooth API)
                self.log("Bluetooth scanning started")
                # In a real app, you would use: bluetooth.start_scan()
                
                # Simulate finding devices
                Clock.schedule_once(self.simulate_scan_results, 2)
                
            except Exception as e:
                self.log(f"Error scanning: {str(e)}")
                self.add_mock_devices()
        else:
            self.log("Bluetooth not available - showing mock devices")
            self.add_mock_devices()
    
    def simulate_scan_results(self, dt):
        """Simulate finding Bluetooth devices"""
        self.status_label.text = "Found 5 devices"
        self.log("Scan complete: Found 5 devices")
    
    def connect_to_device(self, instance):
        """Connect to selected device"""
        self.log("Connecting to device...")
        self.status_label.text = "Connecting..."
    
    def disconnect_device(self, instance):
        """Disconnect from current device"""
        self.log("Disconnecting...")
        self.status_label.text = "Disconnected"
    
    def toggle_bluetooth(self, instance):
        """Toggle Bluetooth on/off"""
        self.log("Toggling Bluetooth...")
        if self.status_label.text == "Bluetooth On":
            self.status_label.text = "Bluetooth Off"
            self.log("Bluetooth turned off")
        else:
            self.status_label.text = "Bluetooth On"
            self.log("Bluetooth turned on")

class BluetoothApp(App):
    """Main application class"""
    def build(self):
        self.title = "Android Bluetooth Manager"
        return BluetoothAppLayout()
    
    def on_start(self):
        """Called when the app starts"""
        print("Bluetooth App started")
    
    def on_stop(self):
        """Called when the app stops"""
        print("Bluetooth App stopped")

if __name__ == "__main__":
    print("Starting Android Bluetooth App...")
    print(f"Bluetooth available: {BLUETOOTH_AVAILABLE}")
    
    # Check Android permissions
    if BLUETOOTH_AVAILABLE:
        print("Note: On Android, you need to request Bluetooth permissions")
        print("Add these to your AndroidManifest.xml:")
        print("  <uses-permission android:name=\"android.permission.BLUETOOTH\" />")
        print("  <uses-permission android:name=\"android.permission.BLUETOOTH_ADMIN\" />")
        print("  <uses-permission android:name=\"android.permission.ACCESS_FINE_LOCATION\" />")
    
    BluetoothApp().run()
