        applicable_exploits = self.get_exploits_for_device(device)
        
        # Run all applicable exploits (mock)
        exploit_results = []
        for exploit in applicable_exploits[:3]:  # Limit to 3 for demo
            result = self.run_exploit(exploit, device)
            exploit_results.append(result)
        
        # Calculate security score
        successful_exploits = sum(1 for r in exploit_results if r["success"])
        security_score = max(0, 100 - (successful_exploits * 20))
        
        return {
            "device": device.to_dict(),
            "security_score": security_score,
            "total_exploits_tested": len(exploit_results),
            "successful_exploits": successful_exploits,
            "exploit_results": exploit_results,
            "overall_security": "Good" if security_score >= 70 else "Fair" if security_score >= 40 else "Poor",
            "timestamp": time.time()
        }


class BLEManager:
    """Main BLE Manager integrating scanner and security tester"""
    
    def __init__(self):
        self.scanner = BLEScanner()
        self.tester = BLESecurityTester()
        self.current_device: Optional[BLEDevice] = None
    
    def scan_and_index_devices(self) -> List[Dict]:
        """Scan for devices and create full index"""
        devices = self.scanner.scan_devices()
        
        # Create comprehensive index
        device_index = []
        for device in devices:
            device_dict = device.to_dict()
            device_dict["exploits_available"] = [
                exploit.to_dict() for exploit in self.tester.get_exploits_for_device(device)
            ]
            device_index.append(device_dict)
        
        return device_index
    
    def get_device_index_by_type(self) -> Dict[str, List[Dict]]:
        """Get device index organized by device type"""
        devices = self.scanner.devices
        index = {}
        
        for device_type in DeviceType:
            type_devices = self.scanner.get_device_by_type(device_type)
            if type_devices:
                index[device_type.value] = [d.to_dict() for d in type_devices]
        
        return index
    
    def run_exploit_on_device(self, exploit_name: str, device_mac: str) -> Dict:
        """Run specific exploit on device by MAC address"""
        device = self.scanner.get_device_by_mac(device_mac)
        if not device:
            return {"error": f"Device with MAC {device_mac} not found"}
        
        exploit = next((e for e in self.tester.exploits if e.name == exploit_name), None)
        if not exploit:
            return {"error": f"Exploit {exploit_name} not found"}
        
        return self.tester.run_exploit(exploit, device)
    
    def get_apple_device_exploits(self) -> List[Dict]:
        """Get all Apple-specific exploits with button text"""
        apple_exploits = [e for e in self.tester.exploits if DeviceType.APPLE in e.target_devices]
        return [exploit.to_dict() for exploit in apple_exploits]


